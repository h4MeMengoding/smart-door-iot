# Copy to .env for local development. Never commit real values.
DATABASE_URL=postgresql://user:password@localhost:5432/smartdoor

# Required for production session signing
AUTH_SECRET=replace-with-a-long-random-secret
SECURE_COOKIES=true
DASHBOARD_PIN=replace-with-a-six-digit-pin

# ESP32 / MQTT server credentials
ESP32_API_KEY=replace-with-a-random-api-key
ESP32_OTA_URL=https://esp.example.com/ota
ESP32_OTA_PASSWORD=replace-with-ota-password
MQTT_BROKER_URL=mqtts://broker.example.com:8883
MQTT_USERNAME=smartdoor-server
MQTT_PASSWORD=replace-with-server-mqtt-password
# Must be unique per deployed dashboard instance (for example, smartdoor-web-server-1).
MQTT_CLIENT_ID=smartdoor-web-server-1

# Browser MQTT credentials must be read-only and are public by design.
NEXT_PUBLIC_MQTT_WS_URL=wss://broker.example.com:8084/mqtt
NEXT_PUBLIC_MQTT_WS_USERNAME=smartdoor-web-readonly
NEXT_PUBLIC_MQTT_WS_PASSWORD=replace-with-readonly-password

# Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=https://example.com
