generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Tabel access_credentials - Menyimpan kredensial akses (RFID cards, dll)
/// uid nullable karena Web/Touch bukan kartu fisik
model AccessCredential {
  id          String   @id @default(uuid())
  uid         String?  @unique
  displayName String   @default("Unknown User") @map("display_name")
  isNamed     Boolean  @default(false) @map("is_named")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("access_credentials")
}

/// Tabel access_logs - Histori akses pintu (append-only)
/// uid nullable karena WEB/TOUCH tidak punya kartu
model AccessLog {
  id           String   @id @default(uuid())
  uid          String?
  accessType   String   @map("access_type") // RFID / WEB / TOUCH
  accessResult String   @map("access_result") // granted / denied
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@index([uid])
  @@map("access_logs")
}

/// Tabel card_delay_configs - Delay per-kartu sebelum pintu unlock
model CardDelayConfig {
  id        String   @id @default(uuid())
  cardUid   String   @unique @map("card_uid")
  delaySec  Int      @default(0) @map("delay_sec")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("card_delay_configs")
}

/// Tabel card_delay_schedules - Time-based delay per-kartu
model CardDelaySchedule {
  id        String   @id @default(uuid())
  cardUid   String   @map("card_uid")
  startHour Int      @map("start_hour")
  endHour   Int      @map("end_hour")
  delaySec  Int      @map("delay_sec")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([cardUid, startHour, endHour])
  @@map("card_delay_schedules")
}

/// Tabel system_configs - Konfigurasi sistem (auto-lock duration, dll)
model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}

/// Tabel system_events - Event sistem non-user (opsional)
model SystemEvent {
  id          String   @id @default(uuid())
  eventType   String   @map("event_type")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@map("system_events")
}

/// Tabel push_subscriptions - Web Push subscriptions for background notifications
model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("push_subscriptions")
}
